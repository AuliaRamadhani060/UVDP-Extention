{
  "manifest_version": 3,
  "name": "Universal Video Player & Downloader",
  "short_name": "UVPD",
  "version": "0.1.0",
  "description": "Deteksi, inspeksi, pemutaran, dan unduhan media HTML5/HLS/DASH yang tidak dilindungi DRM.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "UVPD — media terdeteksi",
    "default_popup": "src/ui/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/ui/options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "downloads",
    "notifications",
    "contextMenus",
    "webRequest",
    "declarativeNetRequest",
    "scripting",
    "tabs",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-Bx0Cb9h9.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "js": [
        "assets/hooks.ts-BZqKPkzn.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "src/ui/player/player.html",
        "assets/browser-BoNqcQYh.js",
        "assets/browser-BoNqcQYh.js.map",
        "assets/messaging-C46JWWw6.js",
        "assets/messaging-C46JWWw6.js.map",
        "assets/url-utils-CWjXbvFi.js",
        "assets/url-utils-CWjXbvFi.js.map",
        "assets/store-DYIi0R97.js",
        "assets/store-DYIi0R97.js.map",
        "assets/index.ts-tiIjBHNp.js",
        "assets/index.ts-tiIjBHNp.js.map",
        "assets/hooks.ts-BZqKPkzn.js",
        "assets/hooks.ts-BZqKPkzn.js.map"
      ],
      "use_dynamic_url": false
    }
  ],
  "side_panel": {
    "default_path": "src/ui/sidepanel/panel.html"
  }
}
