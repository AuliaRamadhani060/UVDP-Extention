{
  "name": "uvpd-extension",
  "version": "0.1.0",
  "description": "Universal Video Player & Downloader — deteksi, inspeksi, pemutaran, dan unduhan media HTML5/HLS/DASH yang tidak dilindungi DRM.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --mode chrome",
    "dev:firefox": "vite --mode firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "cross-env TARGET=chrome vite build --outDir dist/chrome",
    "build:firefox": "cross-env TARGET=firefox vite build --outDir dist/firefox",
    "typecheck": "tsc --noEmit",
    "zip:chrome": "cd dist/chrome && zip -r ../uvpd-chrome.zip .",
    "zip:firefox": "cd dist/firefox && zip -r ../uvpd-firefox.zip ."
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@types/chrome": "^0.0.268",
    "@types/firefox-webext-browser": "^120.0.0",
    "@types/node": "^26.1.1",
    "autoprefixer": "^10.5.3",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@preact/signals": "^2.9.3",
    "@tanstack/react-virtual": "^3.14.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dashjs": "^5.2.0",
    "framer-motion": "^12.42.2",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.24.0",
    "preact": "^10.29.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "webextension-polyfill": "^0.12.0",
    "zustand": "^5.0.14"
  }
}
